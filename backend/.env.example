# ─────────────────────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Front-end (Mini App) manzili — CORS uchun (vergul bilan bir nechta)
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
#  TELEGRAM
# ─────────────────────────────────────────────────────────────
BOT_TOKEN=

# Mini App ochiladigan HTTPS manzil (dev uchun ngrok/cloudflared linki)
WEBAPP_URL=http://localhost:3000

# Webhook rejimi uchun public HTTPS domen. Bo'sh bo'lsa — long polling.
PUBLIC_URL=
WEBHOOK_SECRET=super-secret-webhook-path-token

# ─────────────────────────────────────────────────────────────
#  ADMIN
# ─────────────────────────────────────────────────────────────
# Doimiy adminlar (ID'ni bilsangiz shu yerga yozing, vergul bilan).
# Bo'sh qoldirsangiz ham bo'ladi — pastdagi kod orqali admin bo'lasiz.
ADMIN_CHAT_IDS=

# Bir martalik admin kodi: botga  /admin PIZZA-OWNER-2026  deb yozsangiz,
# siz admin bo'lasiz va ID'ingiz bazaga yoziladi (users.is_admin = true).
# MUHIM: admin bo'lib olgach, bu kodni o'zgartiring yoki bo'sh qoldiring.
ADMIN_SETUP_CODE=change-me-once

# Kod bilan admin bo'lish umuman o'chirilsinmi (true → faqat ADMIN_CHAT_IDS ishlaydi)
ADMIN_SETUP_DISABLED=false

# ─────────────────────────────────────────────────────────────
#  DATABASE (Neon PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
#  BREND VA ALOQA (bot xabarlarida ishlatiladi)
# ─────────────────────────────────────────────────────────────
BRAND_NAME=Pizza Hub
SUPPORT_USERNAME=pizzahub_support
SUPPORT_PHONE=+998 90 000 00 00
WORK_HOURS=10:00 – 23:00
DELIVERY_ETA_MINUTES=30

# ─────────────────────────────────────────────────────────────
#  BIZNES LOGIKA
# ─────────────────────────────────────────────────────────────
CURRENCY=UZS
CURRENCY_SYMBOL=so'm
DELIVERY_FEE=15000
FREE_DELIVERY_FROM=150000

# ─────────────────────────────────────────────────────────────
#  TO'LOV REKVIZITLARI (admin "Tasdiqlash" bosganda mijozga yuboriladi)
# ─────────────────────────────────────────────────────────────
PAYMENT_CARD_NUMBER=8600 1234 5678 9012
PAYMENT_CARD_HOLDER=PIZZA HUB LLC
PAYMENT_NOTE=To'lovdan so'ng chek skrinshotini shu chatga yuboring.
