{
  "name": "pizza-tma-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Mini App — pizza yetkazib berish tizimi (Express + Telegraf + PostgreSQL)",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/migrate.js --force && node src/database/seed.js",
    "telegram:setup": "node scripts/setup-telegram.js",
    "vercel-build": "echo 'backend: build kerak emas'"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  }
}
